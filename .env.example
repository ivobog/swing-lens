# SwingLens local settings
APP_NAME=SwingLens
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
USE_DURABLE_PIPELINE=true

# Local PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/swinglens
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# SQL flight recorder. JSONL only; bind values are never stored.
DB_MONITOR_ENABLED=true
DB_MONITOR_SLOW_QUERY_MS=100
DB_MONITOR_FULL_TRACE_MS=250
DB_MONITOR_FULL_STACK_FOR_ALL_SQL=false
DB_MONITOR_RETENTION_DAYS=8
DB_MONITOR_LOG_DIR=logs/db-monitor
DB_MONITOR_QUEUE_SIZE=10000
DB_MONITOR_MAX_FILE_MB=100
DB_MONITOR_MAX_STACK_FRAMES=20
DB_MONITOR_N_PLUS_ONE_THRESHOLD=10
# Optional pg_stat_activity sampler uses a separate, uninstrumented connection.
DB_MONITOR_ACTIVITY_SAMPLER_ENABLED=false
DB_MONITOR_ACTIVITY_THRESHOLD_MS=1500
DB_MONITOR_ACTIVITY_SAMPLE_INTERVAL_SECONDS=10

# Local storage
UPLOAD_DIR=data/uploads
EXPORT_DIR=data/exports
CACHE_DIR=data/cache

# Interactive Brokers Gateway defaults
# IB Gateway paper commonly uses 4002. Live commonly uses 4001.
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=21
IB_TIMEOUT_SECONDS=30
IB_HEALTH_TIMEOUT_SECONDS=3
IB_GATEWAY_AUTO_LAUNCH_ENABLED=false
IB_GATEWAY_EXECUTABLE_PATH=
IB_USE_RTH=true
IB_DEFAULT_DURATION="3 Y"
IB_FULL_BACKFILL_DURATION="3 Y"
IB_TOP_UP_DURATION="10 D"
IB_REFRESH_DURATION="60 D"
IB_DEFAULT_BAR_SIZE="1 day"
IB_REQUEST_DELAY_SECONDS=0.25
IB_REQUESTS_PER_MINUTE=20
IB_MIN_SECONDS_BETWEEN_REQUESTS=3
IB_BACKOFF_SECONDS=90
IB_MAX_RETRIES=3
IB_FORCE_CONSERVATIVE_MODE=true
IB_FETCH_BENCHMARKS=true
IB_BENCHMARKS="SPY,QQQ"
IB_REQUIRED_DAILY_BARS=252
IB_DAILY_BAR_STALE_AFTER_DAYS=3
IB_REVISION_WINDOW_SESSIONS=5
IB_REVISION_AUDIT_ENABLED=true

# IBKR Market Intelligence (all modules remain off until explicitly enabled)
IB_MARKET_INTELLIGENCE_ENABLED=false
IB_LIQUIDITY_ENABLED=false
IB_SHORT_PRESSURE_ENABLED=false
IB_VOLATILITY_INTELLIGENCE_ENABLED=false
IB_OPTIONS_ACTIVITY_ENABLED=false
IB_SCANNER_ENABLED=false
IB_HISTOGRAM_ENABLED=false
IB_FLEX_JOURNAL_ENABLED=false
IB_INTELLIGENCE_CONFIG_PATH=config/ib_market_intelligence.yaml
IB_INTELLIGENCE_SHORTLIST_LIMIT=25
IB_INTELLIGENCE_HISTORICAL_REQUESTS_PER_MINUTE=15
IB_INTELLIGENCE_HISTORICAL_MIN_SPACING_SECONDS=3
IB_INTELLIGENCE_TWS_MIN_SPACING_SECONDS=0.25
IB_INTELLIGENCE_REQUEST_MAX_ATTEMPTS=3
IB_INTELLIGENCE_RETRY_INITIAL_SECONDS=1
IB_INTELLIGENCE_RETRY_MAX_SECONDS=30
IB_INTELLIGENCE_HISTORICAL_CHUNK_DAYS=60
IB_INTELLIGENCE_LIVE_CONCURRENCY=10
IB_INTELLIGENCE_MARKET_DATA_LINE_CAP=100
IB_LIQUIDITY_LOOKBACK_SESSIONS=20
IB_FEE_RATE_LOOKBACK_SESSIONS=60
IB_VOLATILITY_LOOKBACK_SESSIONS=252
IB_HISTOGRAM_PERIOD=20 days

# Flex is reporting-only HTTPS. Never commit or log real values.
IB_FLEX_TOKEN=
IB_FLEX_TRADE_QUERY_ID=
IB_FLEX_ACTIVITY_QUERY_ID=
IB_FLEX_BASE_URL=https://gdcdyn.interactivebrokers.com/Universal/servlet
IB_FLEX_HTTP_TIMEOUT_SECONDS=30
IB_FLEX_POLL_ATTEMPTS=8
IB_FLEX_POLL_SECONDS=5
IB_FLEX_REPORT_TIMEZONE=UTC

# Technical scoring Phase 3 rollout controls
TECHNICAL_PURE_BOUNDARY_ENABLED=false
TECHNICAL_PURE_BOUNDARY_SHADOW_COMPARE_ENABLED=false
TECHNICAL_PROCESS_POOL_ENABLED=false
TECHNICAL_WORKER_PROCESSES=2
TECHNICAL_MAX_IN_FLIGHT=4
TECHNICAL_SERIES_VERSION_MAINTENANCE_ENABLED=false
# OFF, WRITE_ONLY, SHADOW_VALIDATE, or ACTIVE.
TECHNICAL_ARTIFACT_CACHE_MODE=OFF
# Deprecated compatibility aliases; never enable more than one.
TECHNICAL_ARTIFACT_CACHE_ENABLED=false
TECHNICAL_ARTIFACT_CACHE_WRITE_ENABLED=false
TECHNICAL_ARTIFACT_CACHE_SHADOW_READ_ENABLED=false
FETCH_TECHNICAL_OVERLAP_ENABLED=false
# Prevent nested BLAS/OpenMP oversubscription inside technical worker processes.
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# Market-data prewarm Phase 6 rollout controls
MARKET_DATA_PREWARM_ENABLED=false
MARKET_DATA_PREWARM_MAX_TICKERS=1000
# Optional comma-separated configured watchlist for MARKET_DATA_PREWARM.
MARKET_DATA_PREWARM_WATCHLIST=""
MARKET_DATA_PREWARM_CONFIG_VERSION="market-data-prewarm-v2"
MARKET_DATA_PREWARM_CANCEL_BOUND_SECONDS=45
MARKET_DATA_PREWARM_RESUME_DELAY_SECONDS=30

# Durable pipeline worker defaults. Uvicorn must keep the embedded worker disabled;
# run `python -m app.worker --worker-id swinglens-main --queues interactive,broker,background`.
JOB_WORKER_ENABLED=false
JOB_POLL_INTERVAL_SECONDS=2
JOB_STALE_AFTER_SECONDS=900
JOB_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
JOB_WORKER_HEARTBEAT_TIMEOUT_SECONDS=30
JOB_WORKER_ID=local-worker-1
QUEUE_FAIRNESS_ENABLED=false
JOB_MAX_CONSECUTIVE_INTERACTIVE_CLAIMS=4
JOB_AGE_PROMOTION_SECONDS=300

# Outcome-Calibrated Winner Probability Engine defaults
WINNER_PROBABILITY_ENABLED=false
WINNER_PROBABILITY_CAPTURE_IN_PIPELINE=false
WINNER_PROBABILITY_CONFIG_PATH=config/winner_probability.yaml
WINNER_PROBABILITY_ADMIN_ENABLED=false
WINNER_PROBABILITY_AUTO_MATURATION_ENABLED=false
WINNER_PROBABILITY_AUTO_COHORT_REFRESH_ENABLED=false
WINNER_COHORT_REFRESH_V2_ENABLED=false
WINNER_COHORT_REFRESH_MAX_GROUPS_PER_SLICE=100
WINNER_COHORT_REFRESH_MAX_WALL_SECONDS=45
WINNER_LATEST_RESCORE_MAX_PREDICTIONS_PER_SLICE=250

# Setup Lifecycle and Signal-Change Engine defaults
SETUP_LIFECYCLE_ENABLED=false
SETUP_LIFECYCLE_PIPELINE_STEP_ENABLED=false
SETUP_LIFECYCLE_ALERTS_ENABLED=false
SETUP_LIFECYCLE_REPLAY_ENABLED=false
SETUP_LIFECYCLE_RECONSTRUCTION_ENABLED=false
SETUP_LIFECYCLE_CONFIG_PATH=config/setup_lifecycle.yaml
SETUP_LIFECYCLE_CAPTURE_EVALUATION_TARGET_SECONDS=60
SETUP_LIFECYCLE_API_P95_TARGET_MS=500
SETUP_LIFECYCLE_RETAIN_INDEFINITELY=true
SETUP_LIFECYCLE_PURGE_ENABLED=false
SETUP_LIFECYCLE_PURGE_REQUIRES_PREVIEW=true
SETUP_LIFECYCLE_REPLAY_PROMOTION_REQUIRES_CONFIRMATION=true

# Catalyst and Estimate-Revision Intelligence defaults
CERI_ENABLED=false
CERI_PROVIDER_INGEST_ENABLED=false
# Emergency stabilization: keep legacy per-ticker pipeline fan-out disabled.
# Phase 2 can enable the bounded workflow independently.
CERI_LEGACY_PIPELINE_SCHEDULING_ENABLED=false
CERI_BATCHED_WORKFLOW_ENABLED=false
CERI_PROVIDER_BATCH_SIZE=25
CERI_NORMALIZATION_BATCH_SIZE=50
CERI_FEATURE_BATCH_SIZE=50
CERI_BATCH_CHECKPOINT_INTERVAL=5
CERI_BARRIER_RETRY_SECONDS=5
CERI_RUN_CAPTURE_ENABLED=false
CERI_UI_ENABLED=false
CERI_ALERTS_ENABLED=false
CERI_ADMIN_ENABLED=false
CERI_BACKFILL_ENABLED=false
CERI_CONFIG_PATH=config/ceri.yaml
CERI_TAXONOMY_PATH=config/ceri_catalyst_taxonomy.yaml

# CERI provider credentials and runtime policy (live flags remain off until validation)
EODHD_API_KEY=
EODHD_BASE_URL=https://eodhd.com
EODHD_REQUESTS_PER_MINUTE=300
EODHD_DAILY_CALL_BUDGET=80000
EODHD_HTTP_TIMEOUT_SECONDS=30
EODHD_MAX_ATTEMPTS=4
EODHD_TERMS_VERSION=2026-08-personal
SEC_USER_AGENT="SwingLens/0.1.0 operator@example.invalid"
SEC_REQUESTS_PER_SECOND=2
SEC_HTTP_TIMEOUT_SECONDS=30
SEC_FORM4_ENABLED=false
SEC_DOCUMENT_INCREMENTAL_MODE=OFF
SEC_DOCUMENT_LEASE_SECONDS=900
SEC_DOCUMENT_RETRY_BASE_SECONDS=30

RUNS_DEFAULT_PAGE_SIZE=25
HISTORY_DEFAULT_PAGE_SIZE=50
HISTORY_MAX_PAGE_SIZE=200

# Sanitized, deliberately non-secret release template. Never copy credentials into Git.
# Review against the operator's secure configuration; this file does not activate a runtime.
# Initial containment uses the canonical CERTIFICATION epoch, not an unsupported worker flag.
DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5432/swinglens
APP_HOST=127.0.0.1
APP_PORT=8000
RUNTIME_MODE=CERTIFICATION
PROCESS_ROLE=CLI_OR_MAINTENANCE
USE_DURABLE_PIPELINE=true
DURABLE_WORKER_PROCESS_ENABLED=true
EMBEDDED_JOB_WORKER_ENABLED=false
JOB_WORKER_ENABLED=false
SWINGLENS_MANAGE_POSTGRES=false
SWINGLENS_POSTGRES_SERVICE=postgresql-x64-18
SWINGLENS_POSTGRES_EXPECTED_MAJOR=18

# Preserve required original admission and worker memory behavior.
FUNDAMENTAL_ADMISSION_MODE=ACTIVE
WORKER_MEMORY_RECYCLE_MB=2048
WORKER_MEMORY_WARNING_MB=4096
WORKER_MEMORY_CRITICAL_MB=6144
TECHNICAL_PURE_BOUNDARY_ENABLED=true
TECHNICAL_PURE_BOUNDARY_SHADOW_COMPARE_ENABLED=true
TECHNICAL_PROCESS_POOL_ENABLED=true
TECHNICAL_WORKER_PROCESSES=2
TECHNICAL_MAX_IN_FLIGHT=4
TECHNICAL_SERIES_VERSION_MAINTENANCE_ENABLED=true
TECHNICAL_ARTIFACT_CACHE_MODE=ACTIVE
TECHNICAL_V5_ENABLED=false
TECHNICAL_V5_SHADOW_COMPARE_ENABLED=true

# Capabilities retained; CERTIFICATION does not authorize unrelated jobs or providers.
SETUP_LIFECYCLE_ENABLED=true
SETUP_LIFECYCLE_PIPELINE_STEP_ENABLED=true
WINNER_PROBABILITY_ENABLED=true
WINNER_PROBABILITY_CAPTURE_IN_PIPELINE=true
CERI_ENABLED=true
CERI_PROVIDER_INGEST_ENABLED=true
CERI_RUN_CAPTURE_ENABLED=true
CERI_LEGACY_PIPELINE_SCHEDULING_ENABLED=false
CERI_BATCHED_WORKFLOW_ENABLED=true
SEC_FORM4_ENABLED=true
SEC_DOCUMENT_INCREMENTAL_MODE=ACTIVE

# Automatic workflow flags must stay off during containment.
WINNER_PROBABILITY_AUTO_MATURATION_ENABLED=false
WINNER_PROBABILITY_AUTO_COHORT_REFRESH_ENABLED=false
WINNER_COHORT_REFRESH_V2_ENABLED=true
MARKET_DATA_PREWARM_ENABLED=false
QUEUE_FAIRNESS_ENABLED=true

# Original configuration referenced 1048; 1051 was the observed running installation.
# Operator must confirm the intended version; this template never auto-launches it.
IB_HOST=127.0.0.1
IB_PORT=4002
IB_GATEWAY_AUTO_LAUNCH_ENABLED=false
IB_GATEWAY_EXECUTABLE_PATH=C:/Jts/ibgateway/1051/ibgateway.exe

DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10
DB_MONITOR_ENABLED=true
OBSERVABILITY_METRICS_ENABLED=true
# Supply SEC contact, provider credentials and monitoring secrets through secure local configuration.

+    )
+    detail = _ceri_child_failure_detail(job)
+    assert detail["reason"] == "CERI_IDENTITY_REJECTED"
+    assert detail["classification"]["identity_failures"] == [
+        {
+            "ticker": "ABC",
+            "processing_run_id": 8,
+            "provider": "sec",
+            "dataset": "guidance",
+            "source_count": 1,
+            "records": [record],
+        }
+    ]

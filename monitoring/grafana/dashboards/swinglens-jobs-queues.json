{"uid":"swinglens-jobs-queues","title":"Jobs & Queues","schemaVersion":41,"version":1,"refresh":"10s","panels":[{"id":1,"type":"timeseries","title":"Queue depth","targets":[{"expr":"swinglens_queue_depth"}],"gridPos":{"x":0,"y":0,"w":12,"h":7}},{"id":2,"type":"timeseries","title":"Oldest runnable age","targets":[{"expr":"swinglens_queue_oldest_age_seconds"}],"gridPos":{"x":12,"y":0,"w":12,"h":7}},{"id":3,"type":"timeseries","title":"Job wait p95","targets":[{"expr":"histogram_quantile(0.95,sum by(le,job_type)(rate(swinglens_job_wait_seconds_bucket[5m])))"}],"gridPos":{"x":0,"y":7,"w":12,"h":7}},{"id":4,"type":"timeseries","title":"Job duration p95","targets":[{"expr":"histogram_quantile(0.95,sum by(le,job_type,status)(rate(swinglens_job_duration_seconds_bucket[15m])))"}],"gridPos":{"x":12,"y":7,"w":12,"h":7}},{"id":5,"type":"timeseries","title":"Failures","targets":[{"expr":"sum by(job_type)(rate(swinglens_jobs_failed_total[5m]))"}],"gridPos":{"x":0,"y":14,"w":8,"h":7}},{"id":6,"type":"timeseries","title":"Retries","targets":[{"expr":"sum by(job_type)(rate(swinglens_jobs_retry_total[5m]))"}],"gridPos":{"x":8,"y":14,"w":8,"h":7}},{"id":7,"type":"timeseries","title":"Coalescing","targets":[{"expr":"sum by(job_type)(rate(swinglens_jobs_coalesced_total[5m]))"}],"gridPos":{"x":16,"y":14,"w":8,"h":7}},{"id":8,"type":"timeseries","title":"Fanout attempts by bounded family","targets":[{"expr":"sum by(workflow_family,job_type,result)(rate(swinglens_job_fanout_total[5m]))"}],"gridPos":{"x":0,"y":21,"w":24,"h":7}}]}
